[
  {
    "id": "flowLS",
    "type": "tab",
    "label": "LifeSign & Latence",
    "disabled": false,
    "info": "Surveillance de la périodicité (LifeSign) et de la latence — révèle les DDoS."
  },
  {
    "id": "brkLS",
    "type": "mqtt-broker",
    "name": "Mosquitto central",
    "broker": "192.168.10.10",
    "port": "1883",
    "clientid": "nodered-lifesign-g1",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true
  },
  {
    "id": "uiBaseLS",
    "type": "ui_base",
    "theme": {
      "name": "theme-dark"
    }
  },
  {
    "id": "uiTabLS",
    "type": "ui_tab",
