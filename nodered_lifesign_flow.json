    "order": 2
  },
  {
    "id": "grpLS",
    "type": "ui_group",
    "name": "Surveillance LifeSign / Latence (g1)",
    "tab": "uiTabLS",
    "order": 1,
    "disp": true,
    "width": "8"
  },
  {
    "id": "mqttLS",
    "type": "mqtt in",
    "z": "flowLS",
    "name": "telemetry (LifeSign)",
    "topic": "market/g1/fridge/telemetry",
    "qos": "0",
    "broker": "brkLS",
    "x": 150,
    "y": 120,
    "wires": [
      [
        "fnLife"
      ]
    ]
  },
  {
    "id": "wdog",
    "type": "inject",
    "z": "flowLS",
    "name": "watchdog 1s",
    "props": [
      {
        "p": "payload"
      }
    ],
    "repeat": "1",
    "crontab": "",
    "once": true,
    "onceDelay": 1,
    "topic": "",
    "payload": "",
    "payloadType": "date",
    "x": 150,
    "y": 200,
    "wires": [
      [
        "fnWatch"
      ]
    ]
  },
  {
    "id": "fnLife",
    "type": "function",
    "z": "flowLS",
    "name": "LifeSign / latence",
    "func": "var now = Date.now();\nvar EXP = parseInt(env.get('LIFESIGN_MS')) || 2000;  // périodicité attendue\nvar last = flow.get('ls_last');\nvar interval = (last === undefined) ? EXP : (now - last);\nflow.set('ls_last', now);\nif (interval < 1) interval = 1;\nvar ratio = interval / EXP;\nvar state = ratio <= 1.5 ? 'OK' : (ratio <= 3 ? 'LENT - latence' : 'CRITIQUE - DDoS ?');\nvar d = new Date(now);\nvar p = function(x){ return (x<10?'0':'')+x; };\nvar recu = p(d.getDate())+'/'+p(d.getMonth()+1)+'  '+p(d.getHours())+':'+p(d.getMinutes())+':'+p(d.getSeconds());\nnode.status({fill: ratio<=1.5?'green':(ratio<=3?'yellow':'red'), shape:'dot', text: interval+' ms'});\nreturn [\n  { payload: recu },\n  { payload: interval + ' ms  (attendu ~' + EXP + ' ms)' },\n  { payload: interval },\n  { payload: state },\n  { payload: interval, topic: 'intervalle (ms)' }\n];",
    "outputs": 5,
    "x": 430,
    "y": 120,
    "wires": [
      [
        "uiRecu"
      ],
      [
        "uiDelai"
      ],
      [
        "uiGauge"
      ],
      [
        "uiEtat"
      ],
      [
        "uiChart"
      ]
    ]
  },
  {
    "id": "fnWatch",
    "type": "function",
    "z": "flowLS",
    "name": "watchdog LifeSign",
    "func": "var now = Date.now();\nvar EXP = parseInt(env.get('LIFESIGN_MS')) || 2000;\nvar last = flow.get('ls_last');\nif (last === undefined) return null;\nvar silence = now - last;\nif (silence > EXP*3) {\n  return { payload: 'LifeSign PERDU (' + Math.round(silence/1000) + ' s sans message)' };\n}\nreturn null;",
    "outputs": 1,
    "x": 430,
    "y": 200,
    "wires": [
      [
        "uiEtat"
      ]
    ]
  },
  {
    "id": "uiRecu",
    "type": "ui_text",
    "z": "flowLS",
    "group": "grpLS",
    "order": 1,
    "width": "8",
    "height": "1",
    "name": "Réception",
