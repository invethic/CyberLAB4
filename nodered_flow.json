    "payload": "{\"defrost\":false}",
    "payloadType": "json",
    "topic": "",
    "x": 140,
    "y": 460,
    "wires": [
      [
        "mqttCmdLocal"
      ]
    ]
  },
  {
    "id": "mqttHiveCmd",
    "type": "mqtt in",
    "z": "flow1",
    "name": "cmd distante (HiveMQ)",
    "topic": "market/g1/fridge/cmd",
    "qos": "0",
